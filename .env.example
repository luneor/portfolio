# Contact form (see app/api/contact/route.ts). Copy this file to .env.local
# for local development, and set the same variables under the Vercel
# project's Settings -> Environment Variables for production.

# Required. From https://resend.com — free tier covers 100 emails/day, no
# card needed. Sign up, create an API key, paste it here.
RESEND_API_KEY=

# Optional. Inbox that contact-form submissions are sent to.
# Defaults to hanruweh@hotmail.com if unset.
CONTACT_TO_EMAIL=

# Optional. From-address the email is sent as. Defaults to Resend's shared
# onboarding@resend.dev sender, which works immediately with no setup. Once
# hanruwehmeyer.com is verified as a sending domain in Resend, point this at
# an address on it instead, e.g. "Portfolio <contact@hanruwehmeyer.com>".
RESEND_FROM_EMAIL=
